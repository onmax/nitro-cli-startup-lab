+function lazyCommand<T extends ArgsDef>(
+  meta: CommandMeta,
+  load: () => Promise<CommandDef<T>>
+): CommandDef<T> {
+  return defineCommand({
+    meta,
+    args: async () => {
+      const args = (await load()).args;
+      if (!args) throw new Error("Missing command args");
+      return typeof args === "function" ? args() : args;
+    },
+    run: async (ctx) => {
+      const cmd = await load();
+      return cmd.run?.({ ...ctx, cmd });
+    },
+  });
+}
